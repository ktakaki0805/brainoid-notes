# このファイルを .env にコピーして使う（`mise run setup` が写す）。.env はコミットしない。
# .env は mise が読み込んで、環境変数としてコマンドに渡す（mise.toml の [env]）。

# Postgres（docker compose の db サービスと合わせる）
DATABASE_URL=postgres://brainoid:brainoid@localhost:5432/brainoid

# APIサーバー
API_PORT=8787

# 同期サーバー（Hocuspocus）
SYNC_PORT=8788

# Web（Vite の開発サーバー）から見た各サーバーの場所
VITE_API_URL=http://localhost:8787
VITE_SYNC_URL=ws://localhost:8788
