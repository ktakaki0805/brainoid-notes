{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/drizzle",
      "!**/public",
      "!**/*.md",
      "!**/astryx-themes.ts",
      "!**/themes/*/*.palette.ts",
      "!**/themes/*/*.receipt.json",
      "!**/themes/*/*.css",
      "!**/themes/*/*.d.ts",
      "!**/themes/*/*.js",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
